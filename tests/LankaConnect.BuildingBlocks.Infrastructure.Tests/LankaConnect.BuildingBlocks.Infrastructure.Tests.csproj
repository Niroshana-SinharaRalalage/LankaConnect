<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>LankaConnect.BuildingBlocks.Infrastructure.Tests</RootNamespace>
    <AssemblyName>LankaConnect.BuildingBlocks.Infrastructure.Tests</AssemblyName>
    <Description>Unit tests for BuildingBlocks.Infrastructure (BaseDbContext audit + soft delete + Money EF converter). Uses EF Core InMemory provider for fast feedback. Testcontainers Postgres integration tests are in W2.5b for JSONB-specific scenarios InMemory can't model.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- W2.5b: Testcontainers Postgres for the JSONB ValueComparer integration test -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
    <!-- W1E: Money + Currency in SharedKernel.Money; tests use the types directly. -->
    <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Money\SharedKernel.Money.csproj" />
  </ItemGroup>

</Project>
