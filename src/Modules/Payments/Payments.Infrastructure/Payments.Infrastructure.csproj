<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Modules.Payments.Infrastructure</RootNamespace>
    <AssemblyName>LankaConnect.Modules.Payments.Infrastructure</AssemblyName>
    <Description>Payments module - Infrastructure layer. EF Core repository implementations for the Stripe + RefundRequest repositories. EF Configurations stay in LankaConnect.Infrastructure to avoid the circular ref. Wave 4.4.d.2 (2026-06-23).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Payments.Domain\Payments.Domain.csproj" />
    <ProjectReference Include="..\Payments.Application\Payments.Application.csproj" />
    <!--
      Wave 4.4.d.2 TRANSITIONAL EDGE (2026-06-23). The moved repository impls
      use the Repository&lt;T&gt; base class + AppDbContext share from
      LankaConnect.Infrastructure (no separate PaymentsDbContext in W4.4).
      Mirrors the W5.4.d.2 Communications.Infrastructure -> LankaConnect.Infrastructure
      pattern. Cut alongside the PaymentsDbContext + Repository&lt;T&gt; elevation
      pass.
    -->
    <ProjectReference Include="..\..\..\LankaConnect.Infrastructure\LankaConnect.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>
