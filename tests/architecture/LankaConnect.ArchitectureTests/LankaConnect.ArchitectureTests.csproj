<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>LankaConnect.ArchitectureTests</RootNamespace>
    <AssemblyName>LankaConnect.ArchitectureTests</AssemblyName>
    <Description>Architecture / layering tests. Enforces Clean Architecture rules across BuildingBlocks.* and (eventually) Modules.*. Per master TODO §W2.2 these tests gate PRs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <!--
    Reference every assembly the architecture tests need to inspect.
    NetArchTest.Rules loads types via Types.InAssembly() / Types.InAssemblies(),
    which requires the assembly to be loaded into the test process — which only
    happens if there's a ProjectReference. Add new BuildingBlocks.* / Modules.*
    references here when new layers land in W2.3+ / W3+.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\BuildingBlocks\BuildingBlocks.Domain\BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\BuildingBlocks\BuildingBlocks.Contracts\BuildingBlocks.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\BuildingBlocks\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\..\src\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\BuildingBlocks\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />

    <!-- W3.1 (2026-06-02) — Notifications module skeleton; rules enforce module boundary as types move in W3.2+. -->
    <ProjectReference Include="..\..\..\src\Modules\Notifications\Notifications.Domain\Notifications.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Notifications\Notifications.Contracts\Notifications.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Notifications\Notifications.Application\Notifications.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Notifications\Notifications.Infrastructure\Notifications.Infrastructure.csproj" />

    <!-- W4.1.1 (2026-06-04) — Communications module skeleton. -->
    <ProjectReference Include="..\..\..\src\Modules\Communications\Communications.Domain\Communications.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Communications\Communications.Contracts\Communications.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Communications\Communications.Application\Communications.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Communications\Communications.Infrastructure\Communications.Infrastructure.csproj" />

    <!-- W4.2.1 (2026-06-04) — Media module skeleton. -->
    <ProjectReference Include="..\..\..\src\Modules\Media\Media.Domain\Media.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Media\Media.Contracts\Media.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Media\Media.Application\Media.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Media\Media.Infrastructure\Media.Infrastructure.csproj" />

    <!-- W4.3 (2026-06-06) — Forms module extracted from legacy LankaConnect.Domain.Events. -->
    <ProjectReference Include="..\..\..\src\Modules\Forms\Forms.Domain\Forms.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Forms\Forms.Contracts\Forms.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Forms\Forms.Application\Forms.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Forms\Forms.Infrastructure\Forms.Infrastructure.csproj" />

    <!-- W4.7 (2026-06-06) — CulturalIntelligence module skeleton (StubCulturalCalendar impl moved). -->
    <ProjectReference Include="..\..\..\src\Modules\CulturalIntelligence\CulturalIntelligence.Domain\CulturalIntelligence.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\CulturalIntelligence\CulturalIntelligence.Contracts\CulturalIntelligence.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\CulturalIntelligence\CulturalIntelligence.Application\CulturalIntelligence.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\CulturalIntelligence\CulturalIntelligence.Infrastructure\CulturalIntelligence.Infrastructure.csproj" />

    <!-- W4.5 (2026-06-06) — Scheduling capability skeleton (types populated during Wave 5). -->
    <ProjectReference Include="..\..\..\src\Modules\Scheduling\Scheduling.Domain\Scheduling.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Scheduling\Scheduling.Contracts\Scheduling.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Scheduling\Scheduling.Application\Scheduling.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Scheduling\Scheduling.Infrastructure\Scheduling.Infrastructure.csproj" />

    <!-- W1A (2026-06-04) — BuildingBlocks.Abstractions extracted; ArchTest verifies the abstractions assembly has zero LankaConnect dependencies. -->
    <ProjectReference Include="..\..\..\src\BuildingBlocks\BuildingBlocks.Abstractions\BuildingBlocks.Abstractions.csproj" />

    <!-- W1D-W1G (2026-06-04) — SharedKernel layer (7 packages); ArchTest enforces SharedKernel-only-depends-on-BuildingBlocks invariants. -->
    <ProjectReference Include="..\..\..\src\SharedKernel\SharedKernel.Cultural\SharedKernel.Cultural.csproj" />
    <ProjectReference Include="..\..\..\src\SharedKernel\SharedKernel.Money\SharedKernel.Money.csproj" />
    <ProjectReference Include="..\..\..\src\SharedKernel\SharedKernel.Locale\SharedKernel.Locale.csproj" />
    <ProjectReference Include="..\..\..\src\SharedKernel\SharedKernel.Identity\SharedKernel.Identity.csproj" />
    <ProjectReference Include="..\..\..\src\SharedKernel\SharedKernel.Geo\SharedKernel.Geo.csproj" />
    <ProjectReference Include="..\..\..\src\SharedKernel\SharedKernel.Time\SharedKernel.Time.csproj" />
    <ProjectReference Include="..\..\..\src\SharedKernel\SharedKernel.Contracts\SharedKernel.Contracts.csproj" />
  </ItemGroup>

</Project>
