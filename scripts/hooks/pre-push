#!/bin/sh
# pre-push — git hook entry point. Delegates to pre-push.ps1 for the actual
# CLAUDE.md §13.5 enforcement (T-triggers / S-class annotation + test-debt
# budget). Pure sh wrapper so the hook works on Linux CI runners + Windows
# Git Bash + macOS without per-platform setup.
#
# Installed via: git config core.hooksPath scripts/hooks
# See scripts/hooks/install.ps1.

set -e

HOOK_DIR="$(dirname "$0")"
SCRIPT="$HOOK_DIR/pre-push.ps1"

if [ ! -f "$SCRIPT" ]; then
    echo "pre-push: script not found at $SCRIPT" >&2
    exit 1
fi

# Try PowerShell 7 first (pwsh), fall back to Windows PowerShell 5.1 (powershell.exe).
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT"
elif command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT"
else
    echo "pre-push: neither pwsh nor powershell.exe found on PATH; skipping check." >&2
    exit 0
fi
