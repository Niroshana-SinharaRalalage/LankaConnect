<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Modules.Notifications.Domain</RootNamespace>
    <AssemblyName>LankaConnect.Modules.Notifications.Domain</AssemblyName>
    <Description>Notifications module — Domain layer. Aggregates, entities, value objects, domain events, repository interfaces. Per ADR-002 module boundary: depends only on BuildingBlocks.* + SharedKernel.*; no LankaConnect.Application / LankaConnect.Infrastructure / Modules.* references.</Description>
  </PropertyGroup>

  <!--
    W3A (2026-06-05): legacy LankaConnect.Domain dep CUT. Notification now derives
    from BuildingBlocks.Domain.Entity<Guid> + IAuditable (per ADR-007); INotificationRepository
    derives from BuildingBlocks.Abstractions.IAggregateRepository<Notification, Guid>
    (per ADR-010). The module domain layer is now fully BuildingBlocks-only.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Domain\BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Abstractions\BuildingBlocks.Abstractions.csproj" />
  </ItemGroup>

</Project>
