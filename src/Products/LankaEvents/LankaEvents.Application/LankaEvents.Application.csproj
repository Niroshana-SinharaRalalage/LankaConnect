
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Products.LankaEvents.Application</RootNamespace>
    <AssemblyName>LankaConnect.Products.LankaEvents.Application</AssemblyName>
    <Description>LankaEvents product — Application layer. Command/Query handlers + background jobs + application services. Wave 5.0 skeleton (2026-06-26); handlers move from LankaConnect.Application/Events/ in W5.8.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LankaEvents.Domain\LankaEvents.Domain.csproj" />
    <ProjectReference Include="..\LankaEvents.Contracts\LankaEvents.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
    <!-- Wave 6.5.f (2026-07-09 Day 4): clean-direction PR to LankaEvents.Infrastructure
         mirroring Forms.Application → Forms.Infrastructure. Enabled by the 6.5.f prereq
         cycle-break commit `8c912ca1` that dropped the reverse edge. Handlers now
         inject LankaEventsDbContext + IMultiContextUnitOfWork directly (matches Consult
         #14 PASS B multi-DbContext plan). -->
    <ProjectReference Include="..\LankaEvents.Infrastructure\LankaEvents.Infrastructure.csproj" />

    <!-- Capabilities depended on via Contracts only (per Wave 5 architectural ruling) -->
    <ProjectReference Include="..\..\..\Modules\Identity\Identity.Contracts\Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Modules\Communications\Communications.Contracts\Communications.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Modules\Forms\Forms.Contracts\Forms.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Modules\Payments\Payments.Contracts\Payments.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Modules\Scheduling\Scheduling.Contracts\Scheduling.Contracts.csproj" />
    <!-- Wave 6.5.b canary: emits Media integration events (PhotoAlbumPublishedIntegrationEventV1
         + PhotoUploadedToAlbumIntegrationEventV1) via the outbox from LankaEvents PhotoAlbum handlers. -->
    <ProjectReference Include="..\..\..\Modules\Media\Media.Contracts\Media.Contracts.csproj" />
    <!-- Wave 6.5.b canary: MediaDbContext + MediaModule extension needed by handlers migrating
         to _unitOfWork.CommitAsync(new DbContext[] { _mediaContext }, ct). Legitimate cross-module
         reference because Products.LankaEvents.Application hosts the PhotoAlbum command handlers
         per the Phase A carve-out; Wave 6.5.e will eventually relocate them into Media.Application. -->
    <ProjectReference Include="..\..\..\Modules\Media\Media.Infrastructure\Media.Infrastructure.csproj" />

    <!-- Wave 5.0 TRANSITIONAL (2026-06-26): until the per-capability Application migration
         (Wave 6) cuts the Modules → LankaConnect.Application edges, LankaEvents handlers
         also need access to ICommand / ICommandHandler / IUnitOfWork etc. that live in
         the legacy LankaConnect.Application namespace. Mirror Identity 4.6.d.1 pattern. -->
    <!-- Wave 8.5.a Part 4 (2026-07-17): LankaConnect.Application csproj DELETED
         (D-12 Option b). -->
    <!-- Day 4 slot C sub-slice 4C.d (2026-07-06): mechanical unblock adds.
         Currency in SharedKernel.Money; NewsletterSubscriber in Communications.Domain;
         INewsletterSubscriberRepository + IWhatsAppService in Communications.Application;
         IStripePaymentService in Payments.Application. Transitional edges pending
         Contracts elevation. -->
    <ProjectReference Include="..\..\..\SharedKernel\SharedKernel.Money\SharedKernel.Money.csproj" />
    <!-- Wave 8.5.a Part 4 (2026-07-17): pulled forward from LC.Application (deleted
         in this commit); MetroAreaMappingProfile + GetMetroAreasQuery consume
         MetroAreaDto from LankaConnect.SharedKernel.Geo.MetroAreas.Common. -->
    <ProjectReference Include="..\..\..\SharedKernel\SharedKernel.Geo\SharedKernel.Geo.csproj" />
    <ProjectReference Include="..\..\..\Modules\Communications\Communications.Domain\Communications.Domain.csproj" />
    <!-- IStripePaymentService now lives in Payments.Contracts per Consult #15 PASS C
         (moved 2026-07-06); no longer need Payments.Application PR from LankaEvents. -->

  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <!-- Wave 8.5.a Part 4 (2026-07-17): pulled forward from LC.Application (deleted
         in this commit); mapping profiles + query handlers use AutoMapper Profile +
         IMapper. -->
    <PackageReference Include="AutoMapper" />
    <!-- Wave 6.5.f Day 5 slot A (2026-07-10): CsvExportService + ExcelExportService
         relocated from LC.Infrastructure per architect Option C — pure DTO-in/byte-out
         transformers with no EF touch belong in Application. Their transitive deps
         (CsvHelper for RFC-4180 CSV, ClosedXML for .xlsx generation) move with them. -->
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="ClosedXML" />
  </ItemGroup>

</Project>
