<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Modules.Notifications.Api</RootNamespace>
    <AssemblyName>LankaConnect.Modules.Notifications.Api</AssemblyName>
    <Description>Notifications module — Api layer. ASP.NET Core controllers + NotificationsModule DI extension (AddNotificationsModule). Composes Domain/Application/Infrastructure + BuildingBlocks.Web cross-cutting concerns. Hosted inside Host.AllInOne in Phase A; split out to its own deployable in Phase B (per ADR-002).</Description>
  </PropertyGroup>

  <!--
    W3.1 SKELETON (2026-06-02). Empty shell — NotificationsController + NotificationsModule.AddNotificationsModule extension move in W3.6.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Notifications.Application\Notifications.Application.csproj" />
    <ProjectReference Include="..\Notifications.Domain\Notifications.Domain.csproj" />
    <ProjectReference Include="..\Notifications.Contracts\Notifications.Contracts.csproj" />
    <ProjectReference Include="..\Notifications.Infrastructure\Notifications.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- W3.4 (2026-06-03): NotificationsModule.AddNotificationsModule wires EF Core + Npgsql for NotificationsDbContext. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- W3.6 (2026-06-03): NotificationsController observes the Refactor.Notifications.UseNewModule flag. -->
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
  </ItemGroup>

  <!-- W3.6 TRANSITIONAL EDGE (2026-06-03). NotificationsController uses
       LankaConnect.Domain.Common.Result<T> from the legacy LankaConnect.Domain
       assembly (handlers return the legacy Result type). Cut alongside the
       BuildingBlocks elevation pass that promotes Result<T> to
       BuildingBlocks.Domain. The corresponding ArchTest rule already permits
       this edge for Notifications.Domain → LankaConnect.Domain. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\LankaConnect.Domain\LankaConnect.Domain.csproj" />
  </ItemGroup>

</Project>
