<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Modules.Payments.Application</RootNamespace>
    <AssemblyName>LankaConnect.Modules.Payments.Application</AssemblyName>
    <Description>Payments module - Application layer. PaymentQueries (IPaymentQueries impl), Contract mapping extensions, MediatR handler scan entry point. Wave 4.4.b (2026-06-23).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Payments.Contracts\Payments.Contracts.csproj" />
    <!-- Wave 4.4.d.2 (2026-06-23): Payments.Domain now hosts IStripeCustomerRepository
         + IStripeWebhookEventRepository + IRefundRequestRepository. Their impls in
         Payments.Infrastructure depend on these; Payments.Application's PaymentQueries
         also injects the moved interfaces. -->
    <ProjectReference Include="..\Payments.Domain\Payments.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
    <!--
      Wave 4.4.b EDGE (2026-06-23). PaymentQueries wraps the legacy
      IRefundRequestRepository (LankaConnect.Domain.Events.Repositories) +
      IStripeCustomerRepository / IStripeWebhookEventRepository
      (LankaConnect.Domain.Payments). Per architect Risk #1 Option A ruling,
      RefundRequest + RefundRequestLineItem + RegistrationPayment stay as
      Registration aggregate children in LankaConnect.Domain.Events.Entities.
      So this LankaConnect.Domain edge is the PERMANENT structural compromise,
      NOT transitional. Label stays "transitional" only by analogy with
      W5.4.b; future-me should not waste a wave trying to delete it.
    -->
    <ProjectReference Include="..\..\..\LankaConnect.Domain\LankaConnect.Domain.csproj" />
    <!--
      Wave 4.4.c.1 TRANSITIONAL EDGE (2026-06-23). The 7 moved RefundRequest
      command handlers depend on ICommand / ICommandHandler / IUnitOfWork /
      ICurrentUserService / IApplicationDbContext (from LankaConnect.
      Application.Common.Interfaces) AND IRefundExecutionService /
      IRefundReconciliationService (from LankaConnect.Application.Events.
      Services). Mirrors the W5.4.c.1 + W5.3c.1 transitional edges. Cut
      alongside the BuildingBlocks.Application elevation pass (the
      ICommand/IUnitOfWork primitives) + Wave 4.4.c.4 (the Refund services
      relocation into Payments.Application).
    -->
    <ProjectReference Include="..\..\..\LankaConnect.Application\LankaConnect.Application.csproj" />
    <!--
      Wave 4.4.c.3 TRANSITIONAL EDGE (2026-06-23). The 17 moved Payment / Refund
      event handlers import LankaConnect.Shared.Email.{Contracts,Helpers,Services}
      + LankaConnect.Shared.WhatsApp.Contracts for the email-/whatsapp-emission
      side effects. Mirrors the W5.4.c.1 + W5.3d.2 transitional Shared edges.
      Cut alongside the elevation of Shared.Email + Shared.WhatsApp Contracts
      into BuildingBlocks or a dedicated Communications.Templates module.
    -->
    <ProjectReference Include="..\..\..\LankaConnect.Shared\LankaConnect.Shared.csproj" />
    <ProjectReference Include="..\..\Identity\Identity.Contracts\Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\..\Products\LankaEvents\LankaEvents.Application\LankaEvents.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

</Project>
