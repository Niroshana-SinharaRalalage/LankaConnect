<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Modules.Communications.Infrastructure</RootNamespace>
    <AssemblyName>LankaConnect.Modules.Communications.Infrastructure</AssemblyName>
    <Description>Communications module — Infrastructure layer. Module DbContext, EF configurations, repositories, integration-event dispatch impl. Depends on Application + Domain + Contracts + BuildingBlocks.Infrastructure.</Description>
  </PropertyGroup>

  <!-- W4 SKELETON (2026-06-04). Empty shell — DbContext + repos move in W4.1.4 / baseline migration in W4.1.5. -->

  <ItemGroup>
    <!-- Wave 6.5.f mirror (2026-07-09 Day 4): reverse-direction PR to Communications.Application DELETED after cycle-break. -->
    <ProjectReference Include="..\Communications.Domain\Communications.Domain.csproj" />
    <ProjectReference Include="..\Communications.Contracts\Communications.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
    <!--
      W5.4.d.2 TRANSITIONAL EDGE (2026-06-22). EmailGroupRepository extends
      LankaConnect.Infrastructure.Data.Repositories.Repository T base and
      injects AppDbContext directly (mirrors the W3.4 Notifications.Infrastructure
      + W4.3 Forms.Infrastructure transitional pattern). Cut alongside the
      AppDbContext to CommunicationsDbContext migration in a future wave.
    -->
    <ProjectReference Include="..\..\..\LankaConnect.Infrastructure\LankaConnect.Infrastructure.csproj" />
    <!-- Day 4 slot C sub-slice 4C.d.x (2026-07-08): NewsletterRecipientService
         injects EventMetroAreaMatcher (LankaEvents.Infrastructure/Services).
         Transitional edge; post-sprint move EventMetroAreaMatcher to a shared
         MetroArea capability or BuildingBlocks. -->
    <ProjectReference Include="..\..\..\Products\LankaEvents\LankaEvents.Infrastructure\LankaEvents.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <!-- Wave 8.5.e (2026-07-19): TwilioWhatsAppStrategy.BuildContentVariables
       is `internal static` (helper method); TwilioWhatsAppStrategyTests asserts
       its 1-indexed key contract + JSON escape behaviour. Grant test-project
       assembly visibility instead of promoting the helper to public API surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LankaConnect.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <!-- Wave 8.5.b Part 5 (2026-07-16): email templates relocated from
       LankaConnect.Infrastructure/Templates/Email/. Copy-to-output preserves
       the runtime path "{output}/Templates/Email/**" that RazorEmailTemplateService
       reads via EmailSettings.TemplateBasePath = "Templates/Email". -->
  <ItemGroup>
    <Content Include="Templates\Email\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
