
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Products.LankaEvents.Api</RootNamespace>
    <AssemblyName>LankaConnect.Products.LankaEvents.Api</AssemblyName>
    <Description>LankaEvents product — Api layer. Controllers + composition-root DI extension (LankaEventsModule.AddLankaEventsModule). Wave 5.0 skeleton (2026-06-26); controllers move from LankaConnect.Hosts.AllInOne/Controllers/Events*Controller.cs in W5.9.</Description>
    <!-- Day 4 slot C sub-slice 4C.d.ix (2026-07-08): TargetFramework + ImplicitUsings
         + Nullable enable so Microsoft.AspNetCore.Http (StatusCodes/IFormFile) +
         Extensions.Logging (ILogger) resolve without per-file using directives
         (matches Media.Api pattern from 4C.d.vi). -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LankaEvents.Application\LankaEvents.Application.csproj" />
    <ProjectReference Include="..\LankaEvents.Contracts\LankaEvents.Contracts.csproj" />
    <ProjectReference Include="..\LankaEvents.Infrastructure\LankaEvents.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
    <!-- Day 4 slot C sub-slice 4C.d.ix (2026-07-08): controllers reference
         Identity/Forms/Payments Application types. Same transitional-edge
         pattern used by Media.Api 4C.d.vi. -->
    <ProjectReference Include="..\..\..\Modules\Identity\Identity.Application\Identity.Application.csproj" />
    <ProjectReference Include="..\..\..\Modules\Forms\Forms.Application\Forms.Application.csproj" />
    <ProjectReference Include="..\..\..\Modules\Payments\Payments.Application\Payments.Application.csproj" />
    <ProjectReference Include="..\..\..\SharedKernel\SharedKernel.Money\SharedKernel.Money.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wave 8.5.a Part 4 (2026-07-17): pulled forward from LC.Application (deleted
         in this commit); LankaEventsModule.AddLankaEventsModule uses
         services.AddAutoMapper. -->
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- Day 4 slot C sub-slice 4C.d.ix (2026-07-08): global usings for the
         AspNetCore framework namespaces used across every controller. -->
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Mvc" />
    <Using Include="Microsoft.Extensions.Logging" />
    <!-- Day 4 slot C sub-slice 4C.d.xiii (2026-07-08): local BaseController<T>
         namespace so controllers see it without per-file using; DI + Config
         extensions for GetRequiredService / IConfiguration.GetValue. -->
    <Using Include="LankaConnect.Host.AllInOne.Controllers" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

</Project>
