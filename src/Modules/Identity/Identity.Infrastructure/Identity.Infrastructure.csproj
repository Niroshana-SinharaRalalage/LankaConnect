<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Modules.Identity.Infrastructure</RootNamespace>
    <AssemblyName>LankaConnect.Modules.Identity.Infrastructure</AssemblyName>
    <Description>Identity module - Infrastructure layer. Hosts the 4 moved security adapters (JwtTokenService, EntraExternalIdService, PasswordHashingService, CurrentUserService). User aggregate repository move + ArchTest Rule 5 ship at 4.6.d.2 + 4.6.d.3. Wave 4.6.c.5 (2026-06-24).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wave 6.5.f mirror (2026-07-09 Day 4): reverse-direction PR to Identity.Application DELETED. Identity.Infrastructure has zero usings of Identity.Application types — the reverse edge was false. Removal opens Identity.Application → Identity.Infrastructure clean-direction (matches Forms/LankaEvents/Communications). -->
    <ProjectReference Include="..\Identity.Contracts\Identity.Contracts.csproj" />
    <!--
      Wave 4.6.c.5 TRANSITIONAL EDGES (2026-06-24). The 4 moved security
      adapters reach back into:
       a) LankaConnect.Application.Common.Interfaces (IJwtTokenService,
          IPasswordHashingService ports per architect Risk #2 Option C;
          ICurrentUserService moved to Identity.Contracts at 4.6.a).
       b) LankaConnect.Infrastructure (storage/cache/template helpers).
       c) LankaConnect.Domain (User aggregate, until 4.6.d.2).
       d) LankaConnect.Shared (Email/WhatsApp template helpers).
      Cut alongside the BB.Application elevation + Wave 4.6.d.2 move.
    -->
    <ProjectReference Include="..\..\..\LankaConnect.Application\LankaConnect.Application.csproj" />
    <ProjectReference Include="..\..\..\LankaConnect.Infrastructure\LankaConnect.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\LankaConnect.Domain\LankaConnect.Domain.csproj" />
    <ProjectReference Include="..\..\..\LankaConnect.Shared\LankaConnect.Shared.csproj" />
    <ProjectReference Include="..\Identity.Domain\Identity.Domain.csproj" />
    <!-- 4C.d.xiv (2026-07-08): UserRepository consumes Email VO stub that
         lives in LankaEvents.Domain.ValueObjects (transitional per 4C.a). -->
    <ProjectReference Include="..\..\..\Products\LankaEvents\LankaEvents.Domain\LankaEvents.Domain.csproj" />
    <!-- 4C.e (2026-07-08): IdentityDbContext + operational tables (outbox,
         idempotency, dead-letter) consume BuildingBlocks.Infrastructure. -->
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 4C.e (2026-07-08): EF Core packages needed for IdentityDbContext. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.Identity.Web" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>
