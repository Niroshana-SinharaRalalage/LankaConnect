<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Modules.Forms.Application</RootNamespace>
    <AssemblyName>LankaConnect.Modules.Forms.Application</AssemblyName>
    <Description>Forms module — Application layer. MediatR command/query handlers, DTOs, application services. Depends on Forms.Domain + Forms.Contracts + BuildingBlocks.Application (for pipeline behaviors + abstractions). No Infrastructure / Web / Modules.* leakage per ADR-002 module boundary.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forms.Domain\Forms.Domain.csproj" />
    <ProjectReference Include="..\Forms.Contracts\Forms.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
    <!--
      W5.3c.0 TRANSITIONAL EDGE (2026-06-12). Forms.Application references
      the legacy LankaConnect.Application for ICommand / ICommandHandler /
      ICurrentUserService / IUnitOfWork until BuildingBlocks.Application owns
      those primitives + a richer current-actor abstraction. Cut this edge in
      a follow-up (BuildingBlocks elevation pass) that ALSO cuts the matching
      Notifications.Application transitional edge (added W3.4 2026-06-03 with
      the same rationale). The corresponding ArchTest rule is relaxed during
      the transition window (see LayeringRules.cs).
    -->
    <ProjectReference Include="..\..\..\LankaConnect.Application\LankaConnect.Application.csproj" />
    <!--
      Wave 6.a.1 (2026-07-01): Forms.Application previously referenced
      Products.LankaEvents.Application directly (14 query handlers imported
      EventFormDto family + ExportResult from ...Application.Common /
      ...Application.Queries.ExportEventAttendees). Rule 9 boundary violation.
      Fix: those DTOs + ExportResult moved to Products.LankaEvents.Contracts;
      Forms.Application now references Contracts only. Rule 9 flipped from
      [Fact(Skip)] to live [Fact] in the same commit.
    -->
    <ProjectReference Include="..\..\..\Products\LankaEvents\LankaEvents.Contracts\LankaEvents.Contracts.csproj" />
  </ItemGroup>

</Project>
