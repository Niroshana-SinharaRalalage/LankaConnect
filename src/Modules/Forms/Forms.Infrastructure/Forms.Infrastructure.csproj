<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Modules.Forms.Infrastructure</RootNamespace>
    <AssemblyName>LankaConnect.Modules.Forms.Infrastructure</AssemblyName>
    <Description>Forms module — Infrastructure layer. FormsDbContext (forms schema for operational tables; cross-schema overrides for legacy events.event_forms + events.form_questions + events.form_responses + events.form_answers), EF configurations, EventFormRepository + FormResponseRepository (hand-rolled per ADR-010). No legacy LankaConnect.Infrastructure dependency.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forms.Application\Forms.Application.csproj" />
    <ProjectReference Include="..\Forms.Domain\Forms.Domain.csproj" />
    <ProjectReference Include="..\Forms.Contracts\Forms.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>
