<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Phase 6A.9 FIX: Expose internal members to Infrastructure layer for EF Core persistence concerns -->
  <ItemGroup>
    <InternalsVisibleTo Include="LankaConnect.Infrastructure" />
  </ItemGroup>

  <!-- W2C.1 (2026-06-04): legacy domain references SharedKernel.Cultural for the
       cultural primitives lifted from LankaConnect.Domain.Communications.Enums.
       This is a TRANSITIONAL edge — Wave 4 module extraction empties legacy
       LankaConnect.Domain and removes this reference. -->
  <ItemGroup>
    <ProjectReference Include="..\SharedKernel\SharedKernel.Cultural\SharedKernel.Cultural.csproj" />
  </ItemGroup>

  <!-- W3B (2026-06-05): legacy domain references BuildingBlocks.Domain so individual
       entities can incrementally migrate to Entity<Guid> + IAuditable (per ADR-007)
       without forcing all 79 entities to migrate atomically. Same transitional-edge
       pattern as SharedKernel.Cultural above — empties when entity migration completes
       (W3G) and BaseEntity is deleted. BuildingBlocks.Abstractions provides
       IAggregateRepository<TAggregate, TId> for repository refactor per ADR-010. -->
  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks\BuildingBlocks.Domain\BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\BuildingBlocks\BuildingBlocks.Abstractions\BuildingBlocks.Abstractions.csproj" />
    <ProjectReference Include="..\Modules\Scheduling\Scheduling.Domain\Scheduling.Domain.csproj" />
  </ItemGroup>

</Project>
