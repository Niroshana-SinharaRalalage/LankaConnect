<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.BuildingBlocks.Infrastructure</RootNamespace>
    <AssemblyName>LankaConnect.BuildingBlocks.Infrastructure</AssemblyName>
    <Description>Infrastructure-layer building blocks: BaseDbContext (audit fields, soft delete, JSONB ValueComparer per MEMORY.md), Money EF value converter, OutboxProcessor, IntegrationEventDispatcher, DeadLetterTable. Depends on BuildingBlocks.Application + BuildingBlocks.Domain.</Description>
  </PropertyGroup>

  <!--
    W2.1 SKELETON (2026-05-12). Empty shell — W2.5 fills with persistence primitives.
    Per Clean Architecture: Infrastructure references Application + Domain.
  -->

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\BuildingBlocks.Domain\BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\BuildingBlocks.Contracts\BuildingBlocks.Contracts.csproj" />
    <!-- W1E (2026-06-04): Money + Currency moved BB.Domain -> SharedKernel.Money per D6.
         Infrastructure references SharedKernel.Money for the MoneyConfigurationExtensions
         EF value converter. -->
    <ProjectReference Include="..\..\SharedKernel\SharedKernel.Money\SharedKernel.Money.csproj" />
  </ItemGroup>

  <!-- W2.5 — Infrastructure pulls in EF Core + Npgsql + hosted-service base -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
