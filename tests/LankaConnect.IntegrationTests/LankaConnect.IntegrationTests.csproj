<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Serilog.Sinks.TestCorrelator" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wave 8.5.c (2026-07-21): renamed LankaConnect.API → Host.AllInOne (Consult #26 Q2). -->
    <ProjectReference Include="..\..\src\Hosts\Host.AllInOne\Host.AllInOne.csproj" />
    <ProjectReference Include="..\LankaConnect.TestUtilities\LankaConnect.TestUtilities.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\Identity.Application\Identity.Application.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\Identity.Domain\Identity.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\Identity.Infrastructure\Identity.Infrastructure.csproj" />
    <!-- W5.3.c2 (2026-06-28): EventRepository moved to Products/LankaEvents.Infrastructure;
         EventRepositoryLocationTests directly instantiates EventRepository(_context, _geoLocationService, _logger)
         per the integration-test pattern (DI-bypass for white-box repo tests). LankaConnect.API
         already references this project transitively via LankaEventsModule, but the test assembly
         needs a direct ProjectReference so `using LankaConnect.Products.LankaEvents.Infrastructure.Repositories;` resolves. -->
    <ProjectReference Include="..\..\src\Products\LankaEvents\LankaEvents.Infrastructure\LankaEvents.Infrastructure.csproj" />
    <!-- Wave 8.5.e (2026-07-19): AzureBlobImageServiceIntegrationTests references IImageService
         promoted to Media.Contracts.Services (Wave 8.5.d LegacyPromotions split). -->
    <ProjectReference Include="..\..\src\Modules\Media\Media.Contracts\Media.Contracts.csproj" />
    <!-- Wave 8.5.e (2026-07-19): SimplifiedEmailRepositoryTests + UserRepositoryTests + related
         reference SharedKernel.Contact.Email (promoted from LankaEvents.Domain.ValueObjects
         2026-07-18 commit d13e2b0b per ExtractabilityAudit GAP-6). -->
    <ProjectReference Include="..\..\src\SharedKernel\SharedKernel.Contact\SharedKernel.Contact.csproj" />
  </ItemGroup>

</Project>
