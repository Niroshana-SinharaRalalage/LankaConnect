<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Modules.Forms.Infrastructure</RootNamespace>
    <AssemblyName>LankaConnect.Modules.Forms.Infrastructure</AssemblyName>
    <Description>Forms module — Infrastructure layer. FormsDbContext (forms schema for operational tables; cross-schema overrides for legacy events.event_forms + events.form_questions + events.form_responses + events.form_answers), EF configurations, EventFormRepository + FormResponseRepository (hand-rolled per ADR-010). No legacy LankaConnect.Infrastructure dependency.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Wave 6.5.d (2026-07-03): removed the dormant reverse edge
         Forms.Infrastructure → Forms.Application. The 13 command handlers now
         inject FormsDbContext directly (multi-context UoW pattern), so
         Forms.Application must reference Forms.Infrastructure. Two-way project
         references are forbidden — dropping the unused reverse edge (no
         `using LankaConnect.Modules.Forms.Application` in this assembly per
         2026-07-03 grep) enables the correct one-way flow. -->
    <ProjectReference Include="..\Forms.Domain\Forms.Domain.csproj" />
    <ProjectReference Include="..\Forms.Contracts\Forms.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>
