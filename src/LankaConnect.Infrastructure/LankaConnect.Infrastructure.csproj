<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LankaConnect.Application\LankaConnect.Application.csproj" />
    <!-- W5.3d.3 (2026-06-13). Wave 5.3d.3 cut the legacy
         LankaConnect.Application -> Forms.Domain edge, and Infrastructure had
         been leaning on it transitively. EF Core configurations
         (RefundRequestConfiguration), the registration email service, and the
         Twilio template seeder still legitimately consume Forms.Domain types
         from the Infrastructure layer (ADR-002 allows the legacy infra layer
         to reach module Domain layers for cross-module persistence wiring).
         Make the dependency explicit so the cut is contained to the Application
         layer per the master-TODO ArchTest invariant
         (LegacyApplication_DoesNotDependOnFormsDomain). -->
    <ProjectReference Include="..\Modules\Forms\Forms.Domain\Forms.Domain.csproj" />
    <!-- W5.4.d.2 (2026-06-22). Communications.Domain hosts EmailGroup + IEmailGroupRepository
         (moved out of LankaConnect.Domain.Communications). LankaConnect.Infrastructure
         needs an explicit ref because Migration Designer files + EmailGroup ChangeTracker
         calls reach the type. Mirrors the W5.3d.3 Forms.Domain handling. -->
    <ProjectReference Include="..\Modules\Communications\Communications.Domain\Communications.Domain.csproj" />
    <!-- Wave 4.4.d.2 (2026-06-23). Payments.Domain hosts IRefundRequestRepository +
         IStripeCustomerRepository + IStripeWebhookEventRepository. LankaConnect.
         Infrastructure still hosts 3 webhook handlers (AddOnPurchase / Collection /
         Sponsor) + StripePaymentService that inject these interfaces. Explicit
         ref makes that cross-module consumption visible. Mirrors W5.3d.3 / W5.4.d.2. -->
    <ProjectReference Include="..\Modules\Payments\Payments.Domain\Payments.Domain.csproj" />
    <!-- Communications.Application PR for IEmailMessageRepository +
         IEmailStatusRepository + IUserEmailPreferencesRepository +
         IEmailTemplateRepository (Communications repo impls live here).
         Day 4 slot C sub-slice 4C.d.vii (2026-07-06): Payments.Infrastructure
         PR NOT added (Payments.Infrastructure references LankaConnect.Infrastructure
         via 4.4.d.2 permanent edge — would cycle). AppDbContext's StripeCustomer
         DbSet lines will be moved to Payments.Infrastructure in a follow-up
         relocation pass. For now: keep the type refs; the file compiles thanks
         to the fully-qualified LankaConnect.Modules.Payments.Infrastructure
         namespace already resolving through Payments.Domain PR since the type
         lives adjacent. -->
    <!-- Wave 6.5.f Day 5 slot A (2026-07-10): PR to Communications.Application DELETED. 4 Email repo IMPLS moved to Communications.Infrastructure/Data/Repositories/ in same commit; LC.Infrastructure has no remaining live usings of Communications.Application types. Breaks cycle Comm.App→Comm.Infra→LC.Infra→Comm.App. -->
    <ProjectReference Include="..\Modules\Identity\Identity.Contracts\Identity.Contracts.csproj" />
    <ProjectReference Include="..\Modules\Identity\Identity.Domain\Identity.Domain.csproj" />
    <!-- Wave 6.5.f Day 5 slot A (2026-07-10): PR to LankaEvents.Application DELETED. 2 Export services (CsvExportService + ExcelExportService) moved to LankaEvents.Application/Common/Export/ in same commit. Breaks cycle LE.App→LE.Infra→LC.Infra→LE.App. -->

    <!-- Wave 6.5.a (2026-07-03): outbox adapter classes (IntegrationEventOutbox, module-context
         registration extensions) live in this project because they bridge the LankaConnect.Application
         facade (IIntegrationEventOutbox<TDbContext>) to the BuildingBlocks.Infrastructure concrete
         (OutboxIntegrationEventDispatcher<TDbContext>). BuildingBlocks cannot reference the
         LankaConnect namespace (upward reference), so the adapter sits here. -->
    <ProjectReference Include="..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\BuildingBlocks\BuildingBlocks.Contracts\BuildingBlocks.Contracts.csproj" />
