<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="AspNetCore.HealthChecks.Npgsql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="FluentValidation.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LankaConnect.Application\LankaConnect.Application.csproj" />
    <ProjectReference Include="..\LankaConnect.Infrastructure\LankaConnect.Infrastructure.csproj" />
    <!-- W2.6b — Telemetry extension wires OpenTelemetry + Azure Monitor for staging/prod traces. -->
    <ProjectReference Include="..\BuildingBlocks\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
    <!-- W3.4 (2026-06-03) — Notifications module: hosts AddNotificationsModule + NotificationsController. -->
    <ProjectReference Include="..\Modules\Notifications\Notifications.Api\Notifications.Api.csproj" />
    <!-- W4.2 (2026-06-06) — Media module: hosts AddMediaModule (PhotoAlbum + AlbumPhoto). -->
    <ProjectReference Include="..\Modules\Media\Media.Api\Media.Api.csproj" />
    <!-- W4.3 (2026-06-06) — Forms module: hosts AddFormsModule (EventForm + FormQuestion + FormResponse + FormAnswer). -->
    <ProjectReference Include="..\Modules\Forms\Forms.Api\Forms.Api.csproj" />
    <!-- W5.4.b (2026-06-13) — Communications module: hosts AddCommunicationsModule (IEmailGroupQueries cross-module Contracts surface). EmailGroup aggregate moves to Communications.Domain in W5.4.d.2. -->
    <ProjectReference Include="..\Modules\Communications\Communications.Api\Communications.Api.csproj" />
    <!-- Wave 4.4.b (2026-06-23) — Payments module: hosts AddPaymentsModule (IPaymentQueries cross-module Contracts surface). Per architect Risk #1 Option A, RefundRequest stays a Registration aggregate child in LankaConnect.Domain.Events.Entities. -->
    <ProjectReference Include="..\Modules\Payments\Payments.Api\Payments.Api.csproj" />
    <!-- W4.7 (2026-06-06) — CulturalIntelligence module: hosts AddCulturalIntelligenceModule (StubCulturalCalendar). -->
    <ProjectReference Include="..\Modules\CulturalIntelligence\CulturalIntelligence.Api\CulturalIntelligence.Api.csproj" />
    <ProjectReference Include="..\Modules\Identity\Identity.Api\Identity.Api.csproj" />
    <ProjectReference Include="..\Modules\Identity\Identity.Domain\Identity.Domain.csproj" />
  </ItemGroup>

  <!-- Phase 6A.34: Link Infrastructure email templates to API publish output -->
  <!-- This ensures templates are included in both local builds and Docker deployments -->
  <ItemGroup>
    <Content Include="..\LankaConnect.Infrastructure\Templates\Email\**\*.*">
      <Link>Templates\Email\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
