<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LankaConnect.Modules.Forms.Api</RootNamespace>
    <AssemblyName>LankaConnect.Modules.Forms.Api</AssemblyName>
    <Description>Forms module — Api layer. FormsModule DI extension. Controllers stay in LankaConnect.Hosts.AllInOne for W4.3 (move during W4.8 cross-cutting cleanup).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forms.Application\Forms.Application.csproj" />
    <ProjectReference Include="..\Forms.Domain\Forms.Domain.csproj" />
    <ProjectReference Include="..\Forms.Contracts\Forms.Contracts.csproj" />
    <ProjectReference Include="..\Forms.Infrastructure\Forms.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Web\BuildingBlocks.Web.csproj" />
    <!-- Wave 6.5.d: AddModuleOutbox&lt;FormsDbContext&gt;() DI extension lives here. -->
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    W5.3c (2026-06-12): MediatR + FluentValidation are required at the composition-root
    so FormsModule.AddFormsModule can scan the Forms.Application assembly for the
    moved handlers + validators. Central package management resolves the versions.
  -->
  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <!-- Wave 8.5.a Part 4 (2026-07-17): pulled forward from LC.Application (deleted
         in this commit); FormsModule.AddFormsModule uses AddValidatorsFromAssembly. -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

</Project>
